{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "NuMaker USB HIL (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/usb-hil/NuMaker-X-M55M1D/Release/usb-hil.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": true,
            "preLaunchTask": "NuMaker USB HIL Load",
            "initCommands": [
                "monitor reset halt",
                "tbreak main"
            ],
            "target": {
                "server": "pyocd",
                "serverParameters": [
                    "gdbserver",
                    "--probe",
                    "cmsisdap:",
                    "--cbuild-run",
                    "${workspaceFolder}/out/cmsis-executorch+NuMaker-X-M55M1D.usb-hil.cbuild-run.yml",
                    "--quiet",
                    "--log",
                    "*.cbuild_run,*server=info"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${workspaceFolder}/out/cmsis-executorch+NuMaker-X-M55M1D.usb-hil.cbuild-run.yml",
                "updateConfiguration": "manual"
            }
        },
        {
            // Generated by the CMSIS Solution extension from its Arm-FVP adapter
            // template, then switched to "manual" because two "target" fields
            // differ from the generated ones and would be lost on regeneration:
            //   "port": ""  +  "serverPortRegExp"  -- with a port set, the debug
            //     adapter connects 0 ms after spawning the model, before the
            //     GDBServer plugin listens; blank port makes it wait for the
            //     "GDBServer: Listening ... port=3333" banner instead.
            //   "portDetectionTimeout" -- the first run on macOS builds the
            //     Docker image (see .vscode/fvp.sh).
            // To re-sync after changing target-type or build-type: set
            // "updateConfiguration" to "auto", run "CMSIS: Update Debug Tasks
            // and Launch Configurations", then re-apply the three fields above
            // and set it back to "manual".
            "name": "Arm-FVP@GDB (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/cmsis-executorch/SSE-320-U85/Debug/cmsis-executorch.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off",
                "tbreak main"
            ],
            "target": {
                "server": "${workspaceFolder}/.vscode/fvp.sh",
                "serverParameters": [
                    "-D",
                    "--plugin",
                    "${env:AVH_FVP_PLUGINS}/GDBServer.so",
                    "-C",
                    "GDBServer.port=3333",
                    "-f",
                    "board/Corstone-320/fvp_config.txt",
                    "--simlimit",
                    "60",
                    "-a",
                    "out/cmsis-executorch/SSE-320-U85/Debug/cmsis-executorch.hex"
                ],
                "port": "",
                "serverPortRegExp": "GDBServer: Listening .*port=([0-9]+)",
                "portDetectionTimeout": 300000
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "manual"
            }
        },
        {
            // Separate image, symbols and prepared runner from the traffic launch.
            "name": "NuMaker camera HIL (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/camera-hil/NuMaker-X-M55M1D/Release/camera-hil.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": true,
            "preLaunchTask": "NuMaker camera HIL Load",
            "initCommands": [
                "monitor reset halt",
                "tbreak main"
            ],
            "customResetCommands": [
                "monitor reset halt",
                "maintenance flush register-cache",
                "maintenance flush dcache",
                "tbreak main",
                "continue"
            ],
            "target": {
                "server": "pyocd",
                "serverParameters": [
                    "gdbserver",
                    "--probe",
                    "cmsisdap:",
                    "--cbuild-run",
                    "${workspaceFolder}/out/cmsis-executorch+NuMaker-X-M55M1D.camera-hil.hyperram.cbuild-run.yml",
                    "--quiet",
                    "--log",
                    "*.cbuild_run,*server=info"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${workspaceFolder}/out/cmsis-executorch+NuMaker-X-M55M1D.camera-hil.hyperram.cbuild-run.yml",
                "updateConfiguration": "manual"
            }
        },
        {
            "name": "CMSIS_DAP@pyOCD (attach)",
            "type": "gdbtarget",
            "request": "attach",
            "cwd": "${workspaceFolder}/",
            "program": "out/traffic/NuMaker-X-M55M1D/Release/traffic.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": true,
            "initCommands": [
                ""
            ],
            "customResetCommands": [
                "monitor reset halt",
                "maintenance flush register-cache",
                "maintenance flush dcache",
                "tbreak main",
                "continue"
            ],
            "target": {
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${workspaceFolder}/out/cmsis-executorch+NuMaker-X-M55M1D.hyperram.cbuild-run.yml",
                "updateConfiguration": "manual"
            }
        },
        {
            "name": "CMSIS_DAP@pyOCD (debug loaded image)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/traffic/NuMaker-X-M55M1D/Release/traffic.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": true,
            "initCommands": [
                "monitor reset halt",
                "tbreak main"
            ],
            "customResetCommands": [
                "monitor reset halt",
                "maintenance flush register-cache",
                "maintenance flush dcache",
                "tbreak main",
                "continue"
            ],
            "target": {
                "server": "pyocd",
                "serverParameters": [
                    "gdbserver",
                    "--probe",
                    "cmsisdap:",
                    "--cbuild-run",
                    "${workspaceFolder}/out/cmsis-executorch+NuMaker-X-M55M1D.hyperram.cbuild-run.yml",
                    "--quiet",
                    "--log",
                    "*.cbuild_run,*server=info"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "manual"
            }
        },
        {
            "name": "CMSIS_DAP@pyOCD (inspect running image)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/traffic/NuMaker-X-M55M1D/Release/traffic.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": true,
            "initCommands": [
                ""
            ],
            "target": {
                "server": "pyocd",
                "serverParameters": [
                    "gdbserver",
                    "--probe",
                    "cmsisdap:",
                    "--cbuild-run",
                    "${workspaceFolder}/out/cmsis-executorch+NuMaker-X-M55M1D.hyperram.cbuild-run.yml",
                    "--quiet",
                    "--log",
                    "*.cbuild_run,*server=info"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "manual"
            }
        },
        {
            "name": "CMSIS_DAP@pyOCD (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/traffic/NuMaker-X-M55M1D/Release/traffic.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": true,
            "preLaunchTask": "CMSIS Load",
            "initCommands": [
                "monitor reset halt",
                "tbreak main"
            ],
            "customResetCommands": [
                "monitor reset halt",
                "maintenance flush register-cache",
                "maintenance flush dcache",
                "tbreak main",
                "continue"
            ],
            "target": {
                "server": "pyocd",
                "serverParameters": [
                    "gdbserver",
                    "--probe",
                    "cmsisdap:",
                    "--cbuild-run",
                    "${command:cmsis-csolution.getCbuildRunFile}",
                    "--quiet",
                    "--log",
                    "*.cbuild_run,*server=info"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        }
    ]
}
