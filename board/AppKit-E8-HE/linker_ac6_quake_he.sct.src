; Preprocessed by the CMSIS-Toolbox, not by the armlink "#!" line:
; app_mem_regions.h (the RTE copy in this layer) is force-included by the
; CMSIS-Toolbox through the regions entry of the layer linker node, which
; also makes the toolbox preprocess this .src file with the project defines.

/* The Quake scatter file (board/DevKit-E8/linker_ac6_quake.sct.src) for the M55-HE core:
   its MRAM region and its 256 kB TCMs. The original comment follows.
   linker_ac6_mram.sct.src of this directory, for the Quake project: data lives
   in the 8 MB bulk SRAM by default (the globals of Quake, its surface cache, the
   C library, RTX, the ExecuTorch pools and the frame buffers), and the 1 MB
   DTCM holds what the inner loops of the renderer touch: the sections
   .bss.quake_fast (frame and z-buffer) and .bss.quake_stack (the Quake
   thread stack, which carries the edge, surface and span lists). The hunk
   of Quake is not linked at all: it is the HyperRAM (quake/platform/port_mem.c).
   The first 4 kB of the SRAM stay free: the boot configuration
   (.alif/M55_HP_mram_cfg.json) loads the Cortex-A32 stub there. */

#define __ROM_BASE      APP_MRAM_HE_BASE
#define __ROM_SIZE      APP_MRAM_HE_SIZE

#define __ITCM_BASE     APP_ITCM_BASE
#define __ITCM_SIZE     APP_HE_ITCM_SIZE

#define __RAM_BASE      APP_DTCM_BASE
#define __RAM_SIZE      APP_HE_DTCM_SIZE

#define __STACK_SIZE    0x00004000   /* 16 kB for main and the exception handlers; app_main runs in an RTX thread with its own 32 kB stack (main.c) */
#define __HEAP_SIZE     APP_HE_HEAP_SIZE
#define __APP_HEAP_SIZE 0x00008000

/*----------------------------------------------------------------------------
  User Stack & Heap boundary definition
 *----------------------------------------------------------------------------*/
#define __STACK_TOP     (__RAM_BASE + __RAM_SIZE)    /* starts at end of RAM */
#define __HEAP_BASE     (AlignExpr(+0, 8))           /* starts after RW_RAM section, 8 byte aligned */
#define __APP_HEAP_BASE (AlignExpr(+0, 8))           /* starts after HEAP, 8 byte aligned */

/*----------------------------------------------------------------------------
  Scatter File Definitions definition
 *----------------------------------------------------------------------------*/

#define __RW_BASE       __RAM_BASE
#define __RW_SIZE      (__RAM_SIZE - __STACK_SIZE - __HEAP_SIZE - __APP_HEAP_SIZE)

LR_ROM __ROM_BASE NOCOMPRESS __ROM_SIZE  {    ; load region size_region
  ER_ROM_VECTORS  (AlignExpr(__ROM_BASE, 2048))  {   ; Vector Table
    *vectors.o (RESET, +First)
  }

  ER_ROM (AlignExpr(+0, 8)) {                 ; load address = execution address
   *(InRoot$$Sections)

   ; These should be part of primary load region
   *startup*.o (+RO)
   *system*.o (+RO)
   *sys_*.o (+RO)
   *pm*.o (+RO)
   *tgu*.o (+RO)
   *mpu*.o (+RO)
   *sau_tcm_ns_setup*.o (+RO)

   .ANY (+RO)
   .ANY (+XO)
  }

  ; No code here (see below), but data: Quake's z-buffer (192 kB). The ITCM
  ; answers data accesses like the DTCM does, and the 256 kB DTCM cannot hold it
  ; next to the frame. Not at address 0: a buffer there would be a null pointer.
  ITCM_RAM (__ITCM_BASE + 0x100) (__ITCM_SIZE - 0x100)  {
   * (.bss.quake_zbuf)
   ; No code on purpose. Tried (2026-09): the software renderer of Quake here,
   ; 93 kB. It does not link: armclang gives every C function an exception
   ; index entry, armlink keeps one per run of them, the C++ runtime that
   ; ExecuTorch brings needs the index table in one piece, and a table in the
   ; MRAM (0x80200000) cannot reference code at 0x0 with its 31-bit relative
   ; offsets (L6286E); with the entries in the ITCM too the table is not
   ; contiguous (L6216E). The instruction cache is on, so the MRAM is not as
   ; slow for code as it sounds.
  }

  RW_RAM __RW_BASE __RW_SIZE  {                     ; hot data of the renderer
   * (.bss.quake_fast)                    ; Quake's 8-bit frame (96 kB)
   * (.bss.console_log)                   ; retarget_stdio_log.c: read by the debugger, so not behind the D-cache
  }

  NS_REGION_0  (AlignExpr(+0, TGU_BLOCK_SIZE)) { ; Non secure region 0
    * (eth_buf)
    * (usb_dma_buf)
    * (sd_dma_buf)
    * (.driver.usbd0)
  }

  NS_REGION_0_PAD  (AlignExpr(ImageLimit(NS_REGION_0), TGU_BLOCK_SIZE)) { ; Non secure region 0 Padding
  }
  ScatterAssert((ImageBase(NS_REGION_0_PAD) - ImageBase(NS_REGION_0) + ImageLength(RW_RAM)) < __RW_SIZE)

#if __HEAP_SIZE > 0
  ARM_LIB_HEAP  __HEAP_BASE EMPTY  __HEAP_SIZE  {   ; Reserve empty region for heap
  }
#endif

  APP_HEAP  __APP_HEAP_BASE EMPTY  __APP_HEAP_SIZE {; Reserve empty region for application heap
  }

  ARM_LIB_STACK __STACK_TOP EMPTY -__STACK_SIZE {   ; Reserve empty region for stack
  }

  MRAM_USER  APP_MRAM_USER_BASE  APP_MRAM_USER_SIZE  {
   * (.mram_user)
   * (.mram_user_bss)
  }

#if (SRAM0_SRAM1_COMBINED == 1)
  RW_SRAM (APP_SRAM_BASE + 0x1000) (APP_SRAM_SIZE - 0x1000)  {
   .ANY (+RW +ZI)                         ; everything not named elsewhere
   * (.bss.quake_stack)                   ; M55-HE: the 320 kB Quake stack does not fit the TCMs
   * (.bss.quake_surfcache)               ; the surface cache of Quake
   * (.bss.ai_pool)                       ; ExecuTorch method/temp pools
   * (.bss.lcd_crop_and_interpolate_buf)  ; LCD crop and interpolate image processing buffer.
   * (.bss.lcd_frame_buf)                 ; LCD frame Buffer.
   * (.bss.camera_frame_buf)              ; Camera Frame Buffer
   * (.bss.camera_frame_bayer_to_rgb_buf) ; (Optional) Camera Frame Buffer for Bayer to RGB Conversion.
  }
#else
  RW_SRAM0 APP_SRAM0_BASE APP_SRAM0_SIZE  {  ; Update sections as needed
   * (.bss.ai_pool)                       ; ExecuTorch method/temp pools (src/app_main.cpp)
   * (.bss.lcd_crop_and_interpolate_buf)  ; LCD crop and interpolate image processing buffer.
   * (.bss.lcd_frame_buf)                 ; LCD frame Buffer.
   * (.bss.camera_frame_buf)              ; Camera Frame Buffer
   * (.bss.camera_frame_bayer_to_rgb_buf) ; (Optional) Camera Frame Buffer for Bayer to RGB Conversion.
  }

  /*
   * Note:
   * The below empty regions are ON by default, but may have been released
   * by some example applications. So make sure your application requests
   * power for these regions before adding contents.
   */

  RW_SRAM1 APP_SRAM1_BASE APP_SRAM1_SIZE  {  ; Update sections as needed

  }

#endif
  PADDING +0 OVERLAY ALIGN 16 FILL 0 16
  {
  }
}
