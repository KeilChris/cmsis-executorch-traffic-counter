{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "NuMaker USB HIL Prepare",
            "detail": "Checks USB-only image identity and internal-flash HEX addresses; never accesses hardware.",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/board/NuMaker-X-M55M1D/tests/usb-hil/prepare_launch.py",
                "${command:cmsis-csolution.getCbuildRunFile}",
                "${workspaceFolder}/out/cmsis-executorch+NuMaker-X-M55M1D.usb-hil.cbuild-run.yml"
            ],
            "problemMatcher": []
        },
        {
            "label": "NuMaker USB HIL Load",
            "detail": "Loads only the isolated USB test into internal flash, after launch validation.",
            "dependsOn": "NuMaker USB HIL Prepare",
            "dependsOrder": "sequence",
            "type": "shell",
            "command": "pyocd",
            "args": [
                "load", "--probe", "cmsisdap:", "--cbuild-run",
                "${workspaceFolder}/out/cmsis-executorch+NuMaker-X-M55M1D.usb-hil.cbuild-run.yml"
            ],
            "options": {"cwd": "${workspaceFolder}"},
            "osx": {
                "options": {
                    "shell": {"executable": "/bin/bash", "args": ["-c"]}
                }
            },
            "problemMatcher": []
        },
        {
            "label": "NuMaker HyperRAM Load",
            "detail": "Loads the NuMaker image with the board-specific HyperRAM algorithm instead of the DFP's generic SPIM algorithm.",
            "type": "shell",
            "command": "${workspaceFolder}/board/NuMaker-X-M55M1D/Flash/cmsis-task.sh",
            "args": [
                "load",
                "${command:cmsis-csolution.getCbuildRunFile}",
                "--probe",
                "cmsisdap:"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "NuMaker camera HIL Prepare",
            "detail": "Rejects a non-HIL runner or missing images before preparing a dedicated HyperRAM runner; does not access hardware.",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/board/NuMaker-X-M55M1D/tests/camera-hil/prepare_launch.py",
                "${command:cmsis-csolution.getCbuildRunFile}",
                "${workspaceFolder}/out/cmsis-executorch+NuMaker-X-M55M1D.camera-hil.hyperram.cbuild-run.yml"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "NuMaker camera HIL Load",
            "detail": "Loads only the isolated camera test image after its runner and symbols have been checked.",
            "dependsOn": "NuMaker camera HIL Prepare",
            "dependsOrder": "sequence",
            "type": "shell",
            "command": "pyocd",
            "args": [
                "load",
                "--probe",
                "cmsisdap:",
                "--cbuild-run",
                "${workspaceFolder}/out/cmsis-executorch+NuMaker-X-M55M1D.camera-hil.hyperram.cbuild-run.yml"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Setup Python virtual environment",
            "type": "shell",
            "command": "./setup_venv.sh",
            "windows": {
                "command": ".\\setup_venv.bat"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Setup Python virtual environment (uv)",
            "detail": "Same as above, but with uv (must be on PATH): uv creates .venv for the Python version you enter and can download that interpreter",
            "type": "shell",
            "command": "./setup_venv.sh",
            "windows": {
                "command": ".\\setup_venv.bat"
            },
            "args": ["--uv", "--python", "${input:setupPythonVersion}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Create AI layer",
            "detail": "Export model/model.py for the NPU in cmsis-executorch.cbuild-mlops.yml and write ai_layer/ (run a CMSIS build or 'cbuild setup' first)",
            "type": "shell",
            "command": "python3",
            "args": ["create_ai_layer.py", "cmsis-executorch.cbuild-mlops.yml"],
            "windows": {
                "command": "python"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Alif: Install M55_HP debug stubs (DevKit-E8, single core configuration)",
            "detail": "Programs the ATOC/MRAM stubs with Alif SETOOLS so J-Link can load and debug the M55_HP core. Set SW4 to SEUART, set 'alif.setools.root' in your VS Code settings.",
            "type": "shell",
            "command": [
                "cp './.alif/M55_HP_mram_cfg.json' '${config:alif.setools.root}/build/config/M55_HP_mram_cfg.json';",
                "cp './.alif/M55_HP_mram_stub.bin' '${config:alif.setools.root}/build/images/M55_HP_mram_stub.bin';",
                "cd '${config:alif.setools.root}';",
                "./app-gen-toc -f 'build/config/M55_HP_mram_cfg.json';",
                "./app-write-mram -p ${input:discoverCOM};"
            ],
            "windows": {
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": [
                            "-Command"
                        ]
                    }
                }
            },
            "linux": {
                "options": {
                    "shell": {
                        "executable": "/bin/bash",
                        "args": [
                            "-c"
                        ]
                    }
                }
            },
            "osx": {
                "options": {
                    "shell": {
                        "executable": "/bin/bash",
                        "args": [
                            "-c"
                        ]
                    }
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Alif: Install M55_HE debug stubs (AppKit-E8-HE, single core configuration)",
            "detail": "Programs the ATOC/MRAM stubs with Alif SETOOLS so the M55_HE core boots from MRAM 0x80000000 and J-Link can load and debug it (the M55_HP gets a TCM stub). Set SW4 to SEUART, set 'alif.setools.root' in your VS Code settings.",
            "type": "shell",
            "command": [
                "cp './.alif/M55_HE_mram_cfg.json' '${config:alif.setools.root}/build/config/M55_HE_mram_cfg.json';",
                "cp './.alif/M55_HE_mram_stub.bin' '${config:alif.setools.root}/build/images/M55_HE_mram_stub.bin';",
                "cd '${config:alif.setools.root}';",
                "./tools-config -p 'E8 (AE822FA0E5597BS0) - 5.5 MRAM / 9.75 SRAM';",
                "./app-gen-toc -f 'build/config/M55_HE_mram_cfg.json';",
                "./app-write-mram -p ${input:discoverCOM};"
            ],
            "windows": {
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": [
                            "-Command"
                        ]
                    }
                }
            },
            "linux": {
                "options": {
                    "shell": {
                        "executable": "/bin/bash",
                        "args": [
                            "-c"
                        ]
                    }
                }
            },
            "osx": {
                "options": {
                    "shell": {
                        "executable": "/bin/bash",
                        "args": [
                            "-c"
                        ]
                    }
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Alif: Install M55_HP debug stubs (AppKit-E8, single core configuration)",
            "detail": "As the DevKit-E8 task, for the AppKit's device (AE822FA0E5597BS0): a boot table built for the DevKit's part is skipped by the Secure Enclave. Set SW4 to SEUART, set 'alif.setools.root' in your VS Code settings.",
            "type": "shell",
            "command": [
                "cp './.alif/M55_HP_mram_cfg.json' '${config:alif.setools.root}/build/config/M55_HP_mram_cfg.json';",
                "cp './.alif/M55_HP_mram_stub.bin' '${config:alif.setools.root}/build/images/M55_HP_mram_stub.bin';",
                "cd '${config:alif.setools.root}';",
                "./tools-config -p 'E8 (AE822FA0E5597BS0) - 5.5 MRAM / 9.75 SRAM';",
                "./app-gen-toc -f 'build/config/M55_HP_mram_cfg.json';",
                "./app-write-mram -p ${input:discoverCOM};"
            ],
            "options": {
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Alif: Install M55_HP debug stubs (AppKit-E7, single core configuration)",
            "detail": "As the DevKit-E8 task, for the AppKit-E7's device (AE722F80F55D5LS); the traffic counter's HP core boots from the MRAM. The AppKit-E7 is silicon revision B4 (tools-config -p resets it to A0, and every later step then says 'Revision is invalid'). Set SW4 to SEUART, set 'alif.setools.root' in your VS Code settings.",
            "type": "shell",
            "command": [
                "cp './.alif/M55_HP_mram_cfg_e7.json' '${config:alif.setools.root}/build/config/M55_HP_mram_cfg_e7.json';",
                "cp './.alif/app-device-config-e7.json' '${config:alif.setools.root}/build/config/app-device-config-e7.json';",
                "cp './.alif/M55_HP_mram_stub.bin' '${config:alif.setools.root}/build/images/M55_HP_mram_stub.bin';",
                "cd '${config:alif.setools.root}';",
                "./tools-config -p 'E7 (AE722F80F55D5LS) - 5.5 MRAM / 13.5 SRAM' -r B4;",
                "./app-gen-toc -f 'build/config/M55_HP_mram_cfg_e7.json';",
                "./app-write-mram -p ${input:discoverCOM};"
            ],
            "options": {
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "SDS: play recording to the board (USB)",
            "detail": "Plays CameraIn.<n>.sds of the chosen folder into the detector over the User USB (SDS:IO:USB firmware, board running) and records Detections.<n>.p.sds next to it. One SDSIO server at a time: stop any other playback first.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "traffic/sds_session.py",
                "play",
                "--transport",
                "usb",
                "--workdir",
                "recordings/traffic/${input:sdsRecording}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "SDS: record from the camera (USB)",
            "detail": "Records CameraIn (model inputs) and Detections from the live camera for the given seconds into recordings/traffic over the User USB.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "traffic/sds_session.py",
                "record",
                "${input:sdsSeconds}",
                "--transport",
                "usb"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "SDS: check playback against the host model",
            "detail": "Lists the board's detections of the last playback of the chosen folder next to the float model's on the same inputs.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "traffic/images_to_sds.py",
                "check",
                "recordings/traffic/${input:sdsRecording}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "SDS: video to CameraIn stream",
            "detail": "Extracts frames from a video with ffmpeg at the given rate and builds recordings/traffic/playback/CameraIn.0.sds (letterboxed or filled), ready for 'SDS: play recording to the board'.",
            "type": "shell",
            "command": "rm -rf .sds_frames && mkdir -p .sds_frames && ffmpeg -v error -i \"${input:sdsVideo}\" -vf fps=${input:sdsFps} -q:v 3 .sds_frames/f%06d.jpg && rm -rf recordings/traffic/playback && ${workspaceFolder}/.venv/bin/python traffic/images_to_sds.py make ${input:sdsFraming} recordings/traffic/playback .sds_frames/f*.jpg && rm -rf .sds_frames",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "discoverCOM",
            "type": "pickString",
            "description": "Select COM Port for SETOOLS?",
            "options": [
                {
                    "label": "Yes - Enable COM Port Discovery using command option",
                    "value": "-d"
                },
                {
                    "label": "No - COM port is already selected",
                    "value": ""
                }
            ],
            "default": ""
        },
        {
            "id": "setupPythonVersion",
            "type": "promptString",
            "description": "Python version for uv (>=3.10,<3.15), e.g. 3.12 or 3.12.10",
            "default": "3.12"
        },
        {
            "id": "sdsRecording",
            "type": "promptString",
            "description": "Recording folder under recordings/traffic (with CameraIn.<n>.sds for a playback): playback is what 'SDS: video to CameraIn stream' writes, . the top level that 'SDS: record from the camera' writes",
            "default": "playback"
        },
        {
            "id": "sdsSeconds",
            "type": "promptString",
            "description": "Recording length in seconds",
            "default": "20"
        },
        {
            "id": "sdsVideo",
            "type": "promptString",
            "description": "Video file to convert (any format ffmpeg reads)",
            "default": ""
        },
        {
            "id": "sdsFps",
            "type": "promptString",
            "description": "Frames per second to take from the video (the board detects about 11 per second)",
            "default": "5"
        },
        {
            "id": "sdsFraming",
            "type": "pickString",
            "description": "How a wide frame meets the square model input",
            "options": [
                {
                    "label": "fill: cut the sides, no black bars",
                    "value": "--fill"
                },
                {
                    "label": "letterbox: keep the whole frame, bars above and below",
                    "value": ""
                }
            ],
            "default": "--fill"
        }
    ]
}
